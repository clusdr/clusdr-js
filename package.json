{
  "name": "clusdr",
  "version": "0.2.0",
  "description": "Application SDK for the local Clusdr daemon",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "proto",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "clusdr",
    "cluster",
    "grpc",
    "membership",
    "lock",
    "lease"
  ],
  "author": "The clusdr Authors",
  "license": "Apache-2.0",
  "homepage": "https://clusdr.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clusdr/clusdr-js.git"
  },
  "bugs": {
    "url": "https://github.com/clusdr/clusdr-js/issues"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
